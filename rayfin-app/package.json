{
  "name": "contoso-claims-intake",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Workshop Rayfin app: a Contoso Insurance claims-intake / agent portal. The data model (rayfin/data) provisions a Fabric-backed database, auth, and data APIs; deploy with rayfin up.",
  "scripts": {
    "prebuild": "rayfin env --framework vite",
    "build": "tsc -b && vite build",
    "build:fabric": "tsc -b && vite build",
    "lint": "eslint .",
    "rayfin:up": "rayfin up",
    "rayfin:db": "rayfin up db apply"
  },
  "dependencies": {
    "@microsoft/rayfin-auth-provider-fabric": "^1.33.2",
    "@microsoft/rayfin-client": "^1.33.2",
    "@microsoft/rayfin-core": "^1.33.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.1.1"
  },
  "devDependencies": {
    "@microsoft/rayfin-cli": "^1.33.2",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "typescript": "^5.8.3",
    "vite": "^7.3.2"
  }
}
