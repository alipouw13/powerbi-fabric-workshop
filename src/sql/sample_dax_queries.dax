-- Sample DAX queries for the sm_insurance model.
-- Use these to verify the model, and to demo the Power BI MCP server (remote):
-- in VS Code, GitHub Copilot calls the "Execute Query" tool with a query like
-- these against the semantic model. See labs/lab-09-mcp-github-copilot.

-- 1. Written premium and loss ratio by product
EVALUATE
SUMMARIZECOLUMNS(
    dim_policy[product],
    "Written Premium", [Written Premium],
    "Earned Premium", [Earned Premium],
    "Loss Ratio", [Loss Ratio]
)
ORDER BY [Written Premium] DESC;

-- 2. Loss ratio by region (find the worst-performing books)
EVALUATE
SUMMARIZECOLUMNS(
    dim_policy[region],
    "Earned Premium", [Earned Premium],
    "Incurred Losses", [Incurred Losses],
    "Loss Ratio", [Loss Ratio]
)
ORDER BY [Loss Ratio] DESC;

-- 3. Written premium trend and YoY for Auto
EVALUATE
CALCULATETABLE(
    SUMMARIZECOLUMNS(
        dim_date[period_begin],
        "Written Premium", [Written Premium],
        "Written Premium YoY %", [Written Premium YoY %]
    ),
    dim_policy[product] = "Auto"
)
ORDER BY dim_date[period_begin];

-- 4. Claim count and severity mix by loss type
EVALUATE
SUMMARIZECOLUMNS(
    fact_claim[loss_type],
    "Claim Count", [Claim Count],
    "Incurred Losses", [Incurred Losses],
    "Paid Losses", [Paid Losses]
)
ORDER BY [Incurred Losses] DESC;
